<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0D0E12"
    android:padding="20dp">

    <!-- Nagłówek -->
    <LinearLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GOTHIC II"
                android:textColor="#E0E6ED"
                android:textSize="24sp"
                android:textStyle="bold"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="New Balance Launcher"
                android:textColor="#6C757D"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <Button
            android:id="@+id/btnConfigure"
            android:layout_width="wrap_content"
            android:layout_height="38dp"
            android:minHeight="0dp"
            android:minWidth="0dp"
            android:paddingHorizontal="14dp"
            android:text="Konfiguruj"
            android:textColor="#8AB4F8"
            android:textSize="12sp"
            android:background="#1E222B" />
    </LinearLayout>

    <!-- Karta Gry -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginHorizontal="12dp"
        android:background="#161920"
        android:orientation="vertical"
        android:padding="24dp"
        android:gravity="center_horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="MODIFICATION"
            android:textColor="#FFB74D"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="#2A2415"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginBottom="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Gothic II: New Balance"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold"
            android:gravity="center"/>

        <TextView
            android:id="@+id/tvGameStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Nie gotowe"
            android:textColor="#9AA0A6"
            android:textSize="13sp"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:gravity="center"/>

        <Button
            android:id="@+id/btnAction"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Wybierz plik .exe gry"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold"
            android:background="#2C3038"/>
    </LinearLayout>

</RelativeLayout>
